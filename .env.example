# Supabase Auth and database. The public values are intentionally public;
# the service-role key is server-only and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Workers AI (create a Cloudflare API token with Workers AI access)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=

# Google Gemini API key for selectable Gemini models (server-side only)
GOOGLE_GENERATIVE_AI_API_KEY=

# Tavily web search API key (server-side only)
TAVILY_API_KEY=

# Optional Layerbase Cloud Redis TLS URL for durable stream recovery.
# Keep server-side only; see docs/LAYERBASE_STREAM_RECOVERY.md.
REDIS_URL=

# Optional Netlify background execution for long-running text tasks.
# Set the full Netlify function URL on Vercel and the same random secret on both hosts.
NETLIFY_BACKGROUND_FUNCTION_URL=
NETLIFY_WORKER_SECRET=

# Optional Groq vision models (server-side only)
GROQ_API_KEY=
# Enable only if your Groq account has preview access
# GROQ_VISION_SECONDARY_MODEL=meta-models/muse-spark-open

# Voice transcription is protected by Supabase Auth and server-controlled
# recording sessions. No recording timer is displayed in the frontend.
VOICE_TRANSCRIPTION_ENABLED=false

# OpenNext environment mode
NEXTJS_ENV=development
